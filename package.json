{
  "name": "keyward",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Browser extension password manager over several password vaults.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "KEYWARD_STORE=1 wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome check src e2e",
    "format": "biome check --write src e2e",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm lint && pnpm compile && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bitwarden/sdk-internal": "0.2.0-main.1254",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "diceware-wordlist-en-eff": "1.0.1",
    "input-otp": "^1.5.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.78.0",
    "otpauth": "9.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tldts": "7.5.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
